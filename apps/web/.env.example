# Public, safe in the browser. Same value as the cloud environment's PRIVY_APP_ID.
NEXT_PUBLIC_PRIVY_APP_ID=
# Set to 1 only on a local machine to skip the region gate when cf-ipcountry is absent.
TALLY_ALLOW_MISSING_GEO=
# Set to 1 to expose /dev/wallet-check (M0 only; removed in M3).
NEXT_PUBLIC_ENABLE_WALLET_CHECK=
