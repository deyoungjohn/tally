    "@tally/core": "workspace:*",
    "@tally/engine": "workspace:*",
    "@tally/mod-autopilot": "workspace:*",
    "@tally/mod-flow": "workspace:*",
    "@tally/mod-guardian": "workspace:*",
    "@tally/mod-pies": "workspace:*",
    "@tally/mod-receipts": "workspace:*",
