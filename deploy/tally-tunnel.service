[Unit]
Description=Cloudflare quick tunnel to Tally web (temporary URL; replace with a named tunnel once the domain exists)
After=network-online.target tally-web.service
Wants=network-online.target

[Service]
Type=simple
User=tally
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
