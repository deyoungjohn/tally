# Copy to /etc/tally/tally.env (mode 600, owner root). NEVER commit the real file.
# M0 needs only these three. Later milestones add the Binance key, RPC URLs, Telegram token, etc. (blueprint §14).
NODE_ENV=production
PORT=3000
# Public App ID of the Privy app. Inlined at BUILD time, so it must also be set when running `pnpm build`.
NEXT_PUBLIC_PRIVY_APP_ID=
# Leave unset in production: the region gate fails closed without Cloudflare's cf-ipcountry header.
# TALLY_ALLOW_MISSING_GEO=
# Set to 1 (at build time) to expose /dev/wallet-check for M0 exit check 3. Remove after M0.
# NEXT_PUBLIC_ENABLE_WALLET_CHECK=1
