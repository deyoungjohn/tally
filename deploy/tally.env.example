# Copy to /etc/tally/tally.env (mode 600, owner root). NEVER commit the real file, never paste real values into chat.
# Everything the web app needs lives in this one file, including the public Privy App ID (blueprint §14).
NODE_ENV=production
PORT=3000

# Public App ID of the Privy app. Inlined at BUILD time: load this file before `pnpm build` (docs/deployment.md).
NEXT_PUBLIC_PRIVY_APP_ID=

# Telegram Bot username (without @). Inlined at BUILD time. Used for the Open button.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Telegram Bot Token (server only). Keep secret.
TELEGRAM_BOT_TOKEN=

# Binance Web3 API key (server only; the API refuses US callers, so this runs on the Seoul EC2).
BINANCE_W3_API_KEY=
BINANCE_W3_API_SECRET=

# Dedicated BSC RPC first (the public ones can answer 403, IDEAS F6). The code reads BSC_RPC_PRIMARY, not BSC_RPC_URL.
BSC_RPC_PRIMARY=
# Optional, comma separated. Defaults to the public dataseeds.
# BSC_RPC_FALLBACKS=

# ShareGuard v1 (verified on BscScan). Optional: this is the built-in default.
# SHAREGUARD_ADDRESS=0x28F6F19bffbF25E36452c78d12090F0bC922970a

# A folder the service can write: the Ondo multiplier baseline, stored fills and region declarations.
TALLY_DATA_DIR=/var/lib/tally

# The Ondo multiplier signer (its address is 0xDd3C5F463d71fb06D7bE749F904A4090E080f407). Low privilege: the contract bounds every
# update it signs. Set it by editing this file yourself; it is read by the server only and is never sent to a browser.
FEED_SIGNER_PK=

# Leave unset in production: the region gate fails closed without Cloudflare's cf-ipcountry header.
# TALLY_ALLOW_MISSING_GEO=

# Receipts: set both to 1 to record and verify buy/sell receipts. deploy/restart.sh then also runs the receipts worker (docs/deployment.md).
FEATURE_RECEIPTS=
